#!/usr/bin/env bash
# fill-brief: fill __PLACEHOLDER__s in a template file from KEY=VALUE arguments.
# Usage: fill-brief TEMPLATE KEY=VALUE...
#        fill-brief --out <absolute path> TEMPLATE KEY=VALUE...
#        A VALUE starting with @ is read from that file. All values are literal:
#        multi-line text and & \ / $ pass through unchanged. Without --out, prints
#        the filled template on stdout. With --out, writes it to <path> and prints
#        exactly one line on stdout: Read <path> and follow it.
#        Exit 1 (nothing on stdout, one problem per line on stderr) when a
#        placeholder is left unfilled, a key matches nothing, the output cannot be
#        written, or reading it back differs. Exit 2 on bad usage, including a
#        relative --out path.
set -euo pipefail
# bash 5.2+ treats & in a ${var//pat/rep} replacement as the match; keep it literal.
shopt -u patsub_replacement 2>/dev/null || true

usage() {
  echo "usage: fill-brief TEMPLATE KEY=VALUE... (a VALUE of @FILE reads that file)" >&2
  exit 2
}

[ $# -ge 1 ] || usage
out_path=""
if [ "$1" = "--out" ]; then
  [ $# -ge 3 ] || usage
  out_path="$2"
  case "$out_path" in
    /*) ;;
    *) echo "fill-brief: --out path must be absolute: $out_path" >&2; exit 2 ;;
  esac
  case "$out_path" in
    *$'\n'*) echo "fill-brief: --out path must not contain a newline" >&2; exit 2 ;;
  esac
  shift 2
fi
template="$1"; shift
[ -f "$template" ] || { echo "fill-brief: no such template: $template" >&2; exit 2; }

orig="$(cat "$template"; printf x)"
orig="${orig%x}"

errors=""
add_error() {
  if [ -z "$errors" ]; then errors="$1"; else errors="$errors
$1"; fi
}

keys=()
vals=()
for arg in "$@"; do
  case "$arg" in
    *=*) k="${arg%%=*}"; v="${arg#*=}" ;;
    *) usage ;;
  esac
  [ -n "$k" ] || usage
  keys[${#keys[@]}]="$k"
  vals[${#vals[@]}]="$v"
done

nkeys=${#keys[@]}
i=0
while [ "$i" -lt "$nkeys" ]; do
  v="${vals[$i]}"
  case "$v" in
    @*)
      f="${v#@}"
      if [ -z "$f" ] || [ ! -r "$f" ]; then
        echo "fill-brief: cannot read file for key ${keys[$i]}: $f" >&2
        exit 1
      fi
      vv="$(cat "$f"; printf x)"
      vals[$i]="${vv%x}"
      ;;
  esac
  i=$((i + 1))
done

if [ "$nkeys" -gt 0 ]; then
  for k in "${keys[@]}"; do
    if ! printf '%s' "$orig" | grep -qF "__${k}__"; then
      add_error "unknown key: $k"
    fi
  done
fi

out="$orig"
i=0
while [ "$i" -lt "$nkeys" ]; do
  ph="__${keys[$i]}__"
  v="${vals[$i]}"
  out="${out//"$ph"/$v}"
  i=$((i + 1))
done

leftovers="$(printf '%s' "$out" | grep -oE '__[A-Z][A-Z0-9_]*__' || true)"
seen="|"
while IFS= read -r m; do
  [ -n "$m" ] || continue
  case "$seen" in
    *"|$m|"*) ;;
    *) seen="$seen$m|"; add_error "unfilled: $m" ;;
  esac
done <<<"$leftovers"

if [ -n "$errors" ]; then
  printf '%s\n' "$errors" >&2
  exit 1
fi

if [ -n "$out_path" ]; then
  if ! printf '%s' "$out" >"$out_path"; then
    echo "fill-brief: cannot write output file: $out_path" >&2
    exit 1
  fi
  if ! back="$(cat "$out_path" 2>/dev/null; inner=$?; printf x; exit "$inner")"; then
    echo "fill-brief: cannot read output file: $out_path" >&2
    exit 1
  fi
  back="${back%x}"
  if [ "$back" != "$out" ]; then
    echo "fill-brief: output file does not match filled text: $out_path" >&2
    exit 1
  fi
  printf 'Read %s and follow it.\n' "$out_path"
  exit 0
fi

printf '%s' "$out"
