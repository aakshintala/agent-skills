#!/usr/bin/env bash
# fill-brief: fill __PLACEHOLDER__s in a template file from KEY=VALUE arguments.
# Usage: fill-brief TEMPLATE KEY=VALUE...
#        fill-brief [--out <absolute path>] TEMPLATE KEY=VALUE...
#        --out may appear anywhere among the arguments, at most once.
#        A VALUE starting with @ is read from that file. All values are literal:
#        multi-line text and & \ / $ pass through unchanged. Without --out, prints
#        the filled template on stdout. With --out, missing parent directories
#        are created first, then it writes to <path> and prints
#        exactly one line on stdout: Read <path> and follow it.
#        A template containing __PARENT__ needs a non-empty PARENT value (the
#        parent's session name); there is no fallback.
#        Exit 1 (nothing on stdout, one problem per line on stderr) when a
#        placeholder is left unfilled, a key matches nothing, PARENT is empty,
#        the output cannot be written, or reading it back differs. An unknown-key
#        error is followed by one line naming the keys the template takes.
#        Exit 2 on bad usage, including a key that is not upper-case words joined
#        by single underscores, or a
#        relative --out path.
set -euo pipefail
# bash 5.2+ treats & in a ${var//pat/rep} replacement as the match; keep it literal.
shopt -u patsub_replacement 2>/dev/null || true
# A placeholder: __NAME__, NAME upper-case words joined by single underscores,
# so adjacent placeholders (__A____B__) read as two.
placeholder_re='__[A-Z][A-Z0-9]*(_[A-Z0-9]+)*__'

usage() {
  {
    echo "usage: fill-brief TEMPLATE KEY=VALUE..."
    echo "       fill-brief [--out <absolute path>] TEMPLATE KEY=VALUE..."
    echo "       (a VALUE of @FILE reads that file; --out may come anywhere, once)"
  } >&2
  exit 2
}

out_path=""
have_out=0
args=()
while [ $# -gt 0 ]; do
  case "$1" in --help|-h) usage;; esac
  if [ "$1" = "--out" ]; then
    [ "$have_out" = 0 ] && [ $# -ge 2 ] || usage
    have_out=1
    out_path="$2"
    shift 2
  else
    args[${#args[@]}]="$1"
    shift
  fi
done
[ ${#args[@]} -ge 1 ] || usage
if [ "$have_out" = 1 ]; then
  case "$out_path" in
    /*) ;;
    *) echo "fill-brief: --out path must be absolute: $out_path" >&2; exit 2 ;;
  esac
  case "$out_path" in
    *$'\n'*) echo "fill-brief: --out path must not contain a newline" >&2; exit 2 ;;
  esac
fi
template="${args[0]}"
[ -f "$template" ] || { echo "fill-brief: no such template: $template" >&2; exit 2; }

orig="$(cat "$template"; printf x)"
orig="${orig%x}"

errors=""
add_error() {
  if [ -z "$errors" ]; then errors="$1"; else errors="$errors
$1"; fi
}

keys=()
vals=()
for arg in ${args[@]+"${args[@]:1}"}; do
  case "$arg" in
    *=*) k="${arg%%=*}"; v="${arg#*=}" ;;
    *) usage ;;
  esac
  [[ "__${k}__" =~ ^${placeholder_re}$ ]] || { echo "fill-brief: bad key: $k (upper-case words joined by single underscores)" >&2; exit 2; }
  keys[${#keys[@]}]="$k"
  vals[${#vals[@]}]="$v"
done

nkeys=${#keys[@]}
i=0
while [ "$i" -lt "$nkeys" ]; do
  v="${vals[$i]}"
  case "$v" in
    @*)
      f="${v#@}"
      if [ -z "$f" ] || [ ! -r "$f" ]; then
        echo "fill-brief: cannot read file for key ${keys[$i]}: $f" >&2
        exit 1
      fi
      vv="$(cat "$f"; printf x)"
      vals[$i]="${vv%x}"
      ;;
  esac
  # PARENT is the parent's session name: an empty one is a failure, never a fallback.
  if [ "${keys[$i]}" = "PARENT" ] && [ -z "${vals[$i]}" ]; then
    add_error "empty value: PARENT"
  fi
  i=$((i + 1))
done

if [ "$nkeys" -gt 0 ]; then
  unknown=0
  for k in "${keys[@]}"; do
    if [[ "$orig" != *"__${k}__"* ]]; then
      add_error "unknown key: $k"
      unknown=1
    fi
  done
  if [ "$unknown" = 1 ]; then
    # Name the keys the template takes: its distinct __NAME__ placeholders,
    # in first-appearance order. Exactly one line per run.
    takes="$(printf '%s' "$orig" | grep -oE "$placeholder_re" \
      | awk '!seen[$0]++ { sub(/^__/, ""); sub(/__$/, ""); printf "%s%s", sep, $0; sep=" " }' || true)"
    add_error "fill-brief: $template takes:${takes:+ $takes}"
  fi
fi

# One pass over the template: take the earliest placeholder left, copy the text
# before it, then its value. Substituted text is never scanned again.
out=""
rest="$orig"
while :; do
  best=-1
  best_len=${#rest}
  i=0
  while [ "$i" -lt "$nkeys" ]; do
    pre="${rest%%"__${keys[$i]}__"*}"
    if [ "$pre" != "$rest" ] && [ ${#pre} -lt "$best_len" ]; then
      best=$i
      best_len=${#pre}
    fi
    i=$((i + 1))
  done
  [ "$best" -ge 0 ] || break
  ph="__${keys[$best]}__"
  out="$out${rest:0:best_len}${vals[$best]}"
  rest="${rest:best_len+${#ph}}"
done
out="$out$rest"

# Scan the template minus the given keys, not the output: substituted values are data.
rest="$orig"
i=0
while [ "$i" -lt "$nkeys" ]; do
  rest="${rest//"__${keys[$i]}__"/ }"
  i=$((i + 1))
done
leftovers="$(printf '%s' "$rest" | grep -oE "$placeholder_re" || true)"
seen="|"
while IFS= read -r m; do
  [ -n "$m" ] || continue
  case "$seen" in
    *"|$m|"*) ;;
    *) seen="$seen$m|"; add_error "unfilled: $m" ;;
  esac
done <<<"$leftovers"

if [ -n "$errors" ]; then
  printf '%s\n' "$errors" >&2
  exit 1
fi

if [ -n "$out_path" ]; then
  out_dir="${out_path%/*}"
  [ -n "$out_dir" ] || out_dir="/"
  mkdir -p "$out_dir" 2>/dev/null || true
  if ! printf '%s' "$out" >"$out_path"; then
    echo "fill-brief: cannot write output file: $out_path" >&2
    exit 1
  fi
  if ! back="$(cat "$out_path" 2>/dev/null; inner=$?; printf x; exit "$inner")"; then
    echo "fill-brief: cannot read output file: $out_path" >&2
    exit 1
  fi
  back="${back%x}"
  if [ "$back" != "$out" ]; then
    echo "fill-brief: output file does not match filled text: $out_path" >&2
    exit 1
  fi
  printf 'Read %s and follow it.\n' "$out_path"
  exit 0
fi

printf '%s' "$out"
