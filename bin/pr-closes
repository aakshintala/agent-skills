#!/usr/bin/env bash
# pr-closes: before a merge, check that a PR closes exactly the issues it means to.
# Usage: pr-closes <pr> [--repo OWNER/NAME]
#        pr-closes --check   (reads `gh pr view --json title,body,commits` JSON on stdin)
#        Scans the PR title, body and every commit message for a GitHub closing
#        keyword (close/closes/closed, fix/fixes/fixed, resolve/resolves/resolved,
#        any case, optional colon) before #N or OWNER/REPO#N. The issues the PR
#        means to close are its body's `Resolves #N` lines. Prints one line per
#        keyword match whose issue is not in that list, as
#        "<issue> <title|body|commit SHA>: <matched text>", and exits 1.
#        Exits 0 with one OK line when every closed issue is in the list.
#        Exit 2 on bad usage, or when the PR or its JSON cannot be read.
set -euo pipefail

usage() {
  {
    echo "usage: pr-closes <pr> [--repo OWNER/NAME]"
    echo "       pr-closes --check   (PR JSON on stdin)"
  } >&2
  exit 2
}

# A closing keyword at a word start, optional colon, then an issue reference.
KEYWORD_RE='(^|[^[:alnum:]_])(close[sd]?|fix(e[sd])?|resolve[sd]?):?[[:space:]]*([[:alnum:]_.-]+/[[:alnum:]_.-]+)?#[0-9]+'
RESOLVES_RE='^[[:space:]]*resolves:?[[:space:]]*([[:alnum:]_.-]+/[[:alnum:]_.-]+)?#[0-9]+'

lower() { tr '[:upper:]' '[:lower:]'; }
# ref_of: the issue reference at the end of a keyword match, lowercased.
ref_of() { lower | sed -E 's/^[a-z]+:?[[:space:]]*//'; }

# check: reads PR JSON on stdin, prints the report, returns 0 or 1.
check() {
  local json sources
  json="$(cat)"
  [ -n "$json" ] || { echo "pr-closes: no PR JSON on stdin" >&2; return 2; }
  # NUL-separated pairs: source label, text. CRs dropped from web-edited text.
  sources="$(jq -j '
    def clean: (. // "") | gsub("\r"; "");
    ("title", "\u0000", (.title | clean), "\u0000",
     "body", "\u0000", (.body | clean), "\u0000",
     ((.commits // [])[] | ("commit " + (.oid // "")[0:7]), "\u0000",
       ((.messageHeadline | clean) + "\n\n" + (.messageBody | clean)), "\u0000"))
  ' <<<"$json" 2>/dev/null | tr '\0' '\1')" \
    || { echo "pr-closes: input is not PR JSON" >&2; return 2; }

  local body resolves
  body="$(jq -r '.body // "" | gsub("\r"; "")' <<<"$json")"
  resolves="$(printf '%s\n' "$body" | grep -oiE "$RESOLVES_RE" | sed -E 's/^[[:space:]]*//' | ref_of | sort -u || true)"

  local label text match ref stray=0 total=0
  while IFS= read -r -d $'\1' label && IFS= read -r -d $'\1' text; do
    while IFS= read -r match; do
      [ -n "$match" ] || continue
      match="$(printf '%s' "$match" | sed -E 's/^[^[:alpha:]]//')"
      ref="$(printf '%s' "$match" | ref_of)"
      total=$((total + 1))
      if ! printf '%s\n' "$resolves" | grep -qxF -- "$ref"; then
        echo "$ref $label: $match"
        stray=$((stray + 1))
      fi
    done < <(printf '%s\n' "$text" | grep -oiE "$KEYWORD_RE" || true)
  done < <(printf '%s' "$sources")

  if [ "$stray" -gt 0 ]; then
    echo "pr-closes: $stray closing reference(s) outside the Resolves list; rephrase them (\"see #N\") or add Resolves lines" >&2
    return 1
  fi
  echo "OK: all $total closing reference(s) are in the Resolves list"
}

[ $# -ge 1 ] || usage
if [ "$1" = "--check" ]; then
  [ $# -eq 1 ] || usage
  check
  exit $?
fi

pr="$1"; shift
case "$pr" in ''|*[!0-9]*) usage ;; esac
repo=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || usage; repo="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$repo" ] || repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"

json="$(gh pr view "$pr" --repo "$repo" --json title,body,commits)" \
  || { echo "pr-closes: cannot read PR $pr in $repo" >&2; exit 2; }
printf '%s' "$json" | check
