#!/usr/bin/env bash
# review-pr: run a PR's reviews through the delegate CLI, post one PR comment,
# and print a verdict digest for the orchestrator.
# Usage: review-pr <pr> --repo OWNER/NAME --cwd CLONE --issue N --spec N --model M --ponytail-model M2 [--workflow-doc PATH]
#        review-pr <pr> --repo OWNER/NAME --cwd CLONE --model M --verify FINDINGS_FILE --since SHA [--workflow-doc PATH]
set -euo pipefail

usage() {
  echo "usage: review-pr <pr> --repo OWNER/NAME --cwd CLONE --issue N --spec N --model M --ponytail-model M2 [--workflow-doc PATH]" >&2
  echo "       review-pr <pr> --repo OWNER/NAME --cwd CLONE --model M --verify FINDINGS_FILE --since SHA [--workflow-doc PATH]" >&2
  exit 2
}

[ $# -ge 1 ] || usage
pr="$1"; shift
case "$pr" in -*|"") usage;; esac

repo=""; clone=""; issue=""; specn=""; model=""; pmodel=""
verify=""; since=""; wdoc=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || usage; repo="$2"; shift 2;;
    --cwd) [ $# -ge 2 ] || usage; clone="$2"; shift 2;;
    --issue) [ $# -ge 2 ] || usage; issue="$2"; shift 2;;
    --spec) [ $# -ge 2 ] || usage; specn="$2"; shift 2;;
    --model) [ $# -ge 2 ] || usage; model="$2"; shift 2;;
    --ponytail-model) [ $# -ge 2 ] || usage; pmodel="$2"; shift 2;;
    --verify) [ $# -ge 2 ] || usage; verify="$2"; shift 2;;
    --since) [ $# -ge 2 ] || usage; since="$2"; shift 2;;
    --workflow-doc) [ $# -ge 2 ] || usage; wdoc="$2"; shift 2;;
    *) usage;;
  esac
done

[ -n "$repo" ] || usage
[ -n "$clone" ] && [ -d "$clone" ] || usage
[ -n "$model" ] || usage
if [ -n "$verify" ]; then
  mode="verify"
  [ -n "$since" ] || usage
  [ -f "$verify" ] || usage
  { [ -z "$issue" ] && [ -z "$specn" ] && [ -z "$pmodel" ]; } || usage
else
  mode="review"
  [ -n "$issue" ] && [ -n "$specn" ] && [ -n "$pmodel" ] || usage
  [ -z "$since" ] || usage
fi
if [ -z "$wdoc" ]; then wdoc="none"; fi

script_dir="$(cd "$(dirname "$0")" && pwd)"
skills_dir="$(dirname "$script_dir")/skills"
briefs_dir="$skills_dir/review-loop/briefs"
fill_brief="$script_dir/fill-brief"

if [ "$mode" = "review" ]; then
  roles="review ponytail"
else
  roles="verify"
fi
brief_for() {
  case "$1" in
    review) printf '%s' "$briefs_dir/review.md";;
    ponytail) printf '%s' "$briefs_dir/over-engineering-review.md";;
    verify) printf '%s' "$briefs_dir/verify.md";;
  esac
}
model_for() {
  case "$1" in
    review|verify) printf '%s' "$model";;
    ponytail) printf '%s' "$pmodel";;
  esac
}

sha="$(gh pr view "$pr" --repo "$repo" --json headRefOid | jq -r .headRefOid)"
if [ -z "$sha" ] || [ "$sha" = "null" ]; then
  echo "review-pr: no head SHA for PR $pr in $repo" >&2
  exit 1
fi

tmp="$(mktemp -d "${TMPDIR:-/tmp}/review-pr.XXXXXX")"
wt_list=()
cleanup() {
  if [ "${#wt_list[@]}" -gt 0 ]; then
    for wt in "${wt_list[@]}"; do
      git -C "$clone" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
    done
  fi
  git -C "$clone" worktree prune >/dev/null 2>&1 || true
  rm -rf "$tmp"
}
trap cleanup EXIT

git -C "$clone" fetch origin "pull/$pr/head" >&2

id_list=()
for role in $roles; do
  wt="$tmp/wt-$role"
  git -C "$clone" worktree add --detach "$wt" "$sha" >&2
  wt_list[${#wt_list[@]}]="$wt"

  brief_src="$(brief_for "$role")"
  brief="$tmp/brief-$role.md"
  case "$role" in
    review)
      "$fill_brief" "$brief_src" "PR=$pr" "REPO=$repo" "ISSUE=$issue" \
        "SPEC=$specn" "SKILLS=$skills_dir" "WORKFLOW_DOC=$wdoc" >"$brief"
      ;;
    ponytail)
      "$fill_brief" "$brief_src" "PR=$pr" "REPO=$repo" \
        "SKILLS=$skills_dir" >"$brief"
      ;;
    verify)
      "$fill_brief" "$brief_src" "PR=$pr" "REPO=$repo" "SKILLS=$skills_dir" \
        "SINCE=$since" "FINDINGS=@$verify" >"$brief"
      ;;
  esac

  echo "review-pr: starting $role job ($(model_for "$role"))" >&2
  jid="$(delegate run --model "$(model_for "$role")" --cwd "$wt" --prompt-file "$brief")"
  jid="${jid%%$'\n'*}"
  id_list[${#id_list[@]}]="$role:$jid"
done

watch_ids=""
for pair in "${id_list[@]}"; do
  watch_ids="$watch_ids ${pair#*:}"
done
# shellcheck disable=SC2086
delegate watch $watch_ids --timeout 3600 >/dev/null 2>&1 || true

patch_id="$(gh pr diff "$pr" --repo "$repo" | git patch-id --stable | awk '{print $1}')"
if [ -z "$patch_id" ]; then patch_id="none"; fi

jobs_dir="${TMPDIR:-/tmp}/delegate-jobs"

body="$tmp/comment.md"
{
  printf 'review-pr: patch-id %s, head %s\n' "$patch_id" "$sha"
  for pair in "${id_list[@]}"; do
    role="${pair%%:*}"; jid="${pair#*:}"
    rec="$jobs_dir/$jid.json"
    text=""
    if [ -f "$rec" ]; then
      text="$(jq -r '.result.text // empty' "$rec" 2>/dev/null || true)"
    fi
    printf '\n## %s (%s)\n\n%s\n' "$role" "$(model_for "$role")" "$text"
  done
} >"$body"
gh pr comment "$pr" --repo "$repo" --body-file "$body" >&2

head_line="patch-id $patch_id"

verdicts_f="$tmp/verdicts.txt"
unfinished_f="$tmp/unfinished.txt"
: >"$verdicts_f"
: >"$unfinished_f"
unfinished=0
for pair in "${id_list[@]}"; do
  role="${pair%%:*}"; jid="${pair#*:}"
  rec="$jobs_dir/$jid.json"
  status="MISSING"; gate="none"; text=""
  if [ -f "$rec" ]; then
    status="$(jq -r '.status // "MISSING"' "$rec" 2>/dev/null || echo MISSING)"
    gate="$(jq -r '.result.gateResult.exitCode // "none"' "$rec" 2>/dev/null || echo none)"
    text="$(jq -r '.result.text // empty' "$rec" 2>/dev/null || true)"
  fi
  if [ -n "$text" ]; then
    printf '%s\n' "$text" | grep -E '^(VERDICT|P[123] |FIX-OK|FIX-INCOMPLETE)' >>"$verdicts_f" || true
  fi
  if [ "$status" != "DONE" ]; then
    printf 'UNFINISHED %s %s gate=%s %s\n' "$role" "$status" "$gate" "$rec" >>"$unfinished_f"
    unfinished=$((unfinished + 1))
  elif ! printf '%s' "$text" | grep -qE '^(VERDICT|FIX-)'; then
    printf 'UNFINISHED %s %s gate=%s %s\n' "$role" "$status" "$gate" "$rec" >>"$unfinished_f"
    unfinished=$((unfinished + 1))
  fi
done
short="${sha:0:8}"
checks="$(gh pr checks "$pr" --repo "$repo" 2>/dev/null || true)"
ci="none"
if [ -n "$checks" ]; then
  ci="pass"
  while IFS= read -r line; do
    case "$line" in ""|NAME*|Name*) continue;; esac
    state="$(printf '%s\n' "$line" | awk -F'\t' '{print $2}')"
    if [ -z "$state" ]; then
      state="$(printf '%s\n' "$line" | awk '{print $2}')"
    fi
    case "$state" in
      fail|failed|failure) ci="fail"; break;;
      pending|queued|requested|waiting|in_progress)
        if [ "$ci" != "fail" ]; then ci="pending"; fi;;
    esac
  done <<<"$checks"
fi

printf '%s\n' "$head_line"
cat "$verdicts_f"
printf 'CI %s %s\n' "$short" "$ci"
cat "$unfinished_f"

if [ "$unfinished" -gt 0 ]; then exit 1; fi
exit 0
