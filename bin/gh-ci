#!/usr/bin/env bash
# gh-ci: quiet, low-call GitHub CI helpers for agent flywheels.
# Usage: gh-ci snapshot <pr> | failures <run> | watch-verified <run> --pr <n>
#        gh-ci resample <pr> "<job name>" --until <regex> [--max <n>]
#        gh-ci wait <pr> [--timeout <s>]
# Exit codes: 0 ok, 1 failure, 2 usage, 3 merge conflict (snapshot and
# watch-verified at once; wait after 30 s of DIRTY re-checks), 124 wait timeout.
# GH_CI_REPO overrides the repo (default: the current checkout's origin); GH_CI_INTERVAL the watch poll seconds (default 30).
set -euo pipefail
usage() {
  echo "usage: gh-ci snapshot <pr> | failures <run> | watch-verified <run> --pr <n>" >&2
  echo "       gh-ci resample <pr> \"<job name>\" --until <regex> [--max <n>]" >&2
  echo "       gh-ci wait <pr> [--timeout <s>]" >&2
  exit 2
}

CONFLICT_RC=3

# head_state <pr>: prints "<full head SHA> <mergeStateStatus>". Fails when the head is unreadable.
head_state() {
  local sha state
  read -r sha state < <(gh pr view "$1" --repo "$REPO" --json headRefOid,mergeStateStatus --jq '"\(.headRefOid) \(.mergeStateStatus)"') || true
  if [[ "${sha:-}" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "$sha ${state:-}"
  else
    echo "could not read the head of PR $1" >&2
    return 1
  fi
}

conflict_msg() { echo "PR $1 has merge conflicts: GitHub runs no CI on it. Rebase first." >&2; }

# pr_head <pr>: prints the full head SHA. Returns 3 on a conflicting (DIRTY)
# PR, because GitHub never runs CI on one and a watch would wait forever.
pr_head() {
  local sha state
  read -r sha state < <(head_state "$1") || return 1
  if [ "$state" = "DIRTY" ]; then
    conflict_msg "$1"
    return "$CONFLICT_RC"
  fi
  echo "$sha"
}

# snapshot <pr>: head SHA + CI/flake verdicts + pending/failing counts.
# Two API calls total: one pr view, one pr checks.
cmd_snapshot() {
  local pr="${1:?missing pr number}"
  local out head ci flake pending fails
  head=$(pr_head "$pr")
  echo "head: ${head:0:8}"
  out=$(gh pr checks "$pr" --repo "$REPO" 2>&1 || true)
  ci=$(echo "$out" | awk -F'\t' 'tolower($1) == "ci" {print $2; exit}')
  flake=$(echo "$out" | awk -F'\t' '$1 ~ /^Flake watch/ {print $2; exit}')
  echo "CI: ${ci:-unknown}"
  echo "Flake: ${flake:-unknown}"
  pending=$(echo "$out" | awk -F'\t' '$2 == "pending" || $2 == "queued" {n++} END {print n+0}')
  fails=$(echo "$out" | awk -F'\t' '$2 == "fail" {n++} END {print n+0}')
  echo "pending: $pending failing: $fails"
}

# failures <run>: failed jobs, then their (fail) test lines only.
cmd_failures() {
  local run="${1:?missing run id}"
  local jobs
  jobs=$(gh run view "$run" --repo "$REPO" --json jobs --jq '.jobs[] | select(.conclusion=="failure") | "\(.databaseId) \(.name)"')
  if [ -z "$jobs" ]; then echo "no failed jobs in run $run"; return 0; fi
  echo "$jobs"
  echo "$jobs" | while read -r jid _; do
    echo "--- $jid failing tests ---"
    gh run view "$run" --repo "$REPO" --job "$jid" --log-failed 2>&1 \
      | grep -E "\(fail\)" | sed 's/^[^Z]*Z //' | sort -u | sed -n '1,10p'
  done
}

# watch-verified <run> --pr <n>: watch, then verify via pr checks.
# Exit 0 only when CI passes with zero pending on the PR head. A watch
# firing means "look", never "it's green" — this is the look.
cmd_watch_verified() {
  local run="${1:?missing run id}"; shift
  local pr=""
  while [ $# -gt 0 ]; do case "$1" in --pr) pr="${2:?}"; shift 2;; *) usage;; esac; done
  [ -n "$pr" ] || usage
  local head run_sha
  head=$(pr_head "$pr")
  run_sha=$(gh run view "$run" --repo "$REPO" --json headSha --jq .headSha)
  if [ "$run_sha" != "$head" ]; then
    echo "run $run is on ${run_sha:0:8}, PR head is ${head:0:8}: stale run" >&2
    return 1
  fi
  # gh run watch polls every 3s by default; several concurrent watchers
  # trip GitHub's secondary rate limit on the Actions API.
  gh run watch "$run" --repo "$REPO" --exit-status --interval "${GH_CI_INTERVAL:-30}" >/dev/null || true
  local out ci pending
  out=$(gh pr checks "$pr" --repo "$REPO" 2>&1 || true)
  ci=$(echo "$out" | awk -F'\t' 'tolower($1) == "ci" {print $2; exit}')
  pending=$(echo "$out" | awk -F'\t' '$2 == "pending" || $2 == "queued" {n++} END {print n+0}')
  echo "head: ${head:0:8} CI: ${ci:-unknown} pending: $pending"
  echo "$out" | grep -E "fail" | head -5 || true
  [ "$ci" = "pass" ] && [ "$pending" = "0" ]
}

# resample <pr> "<job name>" --until <regex> [--max <n>]: rerun the PR's latest
# run until the named job's log matches the regex (a flake caught in a net).
# Logs land in $GH_CI_OUT (default /tmp/gh-ci-resample-<pr>). Waits on the
# whole run, because a rerun is refused while any job is still in progress,
# and fetches the job log through the API, because `gh run view --log`
# refuses while the run is in progress.
cmd_resample() {
  local pr="${1:?missing pr number}"; local job="${2:?missing job name}"; shift 2
  local until_re="" max=12
  while [ $# -gt 0 ]; do case "$1" in
    --until) until_re="${2:?}"; shift 2;;
    --max) max="${2:?}"; shift 2;;
    *) usage;; esac; done
  [ -n "$until_re" ] || usage
  local out="${GH_CI_OUT:-/tmp/gh-ci-resample-$pr}"; mkdir -p "$out"
  local branch run
  branch=$(gh pr view "$pr" --repo "$REPO" --json headRefName --jq .headRefName)
  run=$(gh run list --repo "$REPO" --branch "$branch" --workflow ci.yml --limit 1 --json databaseId --jq '.[0].databaseId')
  [ -n "$run" ] || { echo "no run on $branch (unmergeable PRs get none)" >&2; return 1; }
  echo "run: $run"
  local attempt jid concl log
  for attempt in $(seq 1 "$max"); do
    while [ "$(gh run view "$run" --repo "$REPO" --json status --jq .status)" != "completed" ]; do
      sleep "${GH_CI_INTERVAL:-60}"
    done
    jid=$(gh run view "$run" --repo "$REPO" --json jobs --jq ".jobs[] | select(.name==\"$job\") | .databaseId" | tail -1)
    concl=$(gh run view "$run" --repo "$REPO" --json jobs --jq ".jobs[] | select(.name==\"$job\") | .conclusion" | tail -1)
    log="$out/attempt-$attempt.log"
    gh api --allow-escape-sequences "repos/$REPO/actions/jobs/$jid/logs" > "$log" 2>&1 || true
    echo "attempt: $attempt job: $jid conclusion: ${concl:-unknown} log: $log"
    if grep -aqE "$until_re" "$log"; then echo "caught: $log"; return 0; fi
    gh run rerun "$run" --repo "$REPO" >/dev/null
    sleep 90
  done
  echo "no match in $max attempts"; return 1
}

# required_names <pr>: the required check names on the PR's base branch,
# from rulesets and classic protection (a classic 404 means none), one per line.
required_names() {
  local base rules classic
  base=$(gh pr view "$1" --repo "$REPO" --json baseRefName --jq .baseRefName) && [ -n "$base" ] || return 1
  rules=$(gh api "repos/$REPO/rules/branches/$base" \
    --jq '.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context') || return 1
  if ! classic=$(gh api "repos/$REPO/branches/$base/protection/required_status_checks" --jq '.contexts[]?' 2>&1); then
    case "$classic" in *"HTTP 404"*) classic="" ;; *) return 1 ;; esac
  fi
  printf '%s\n' "$rules" "$classic" | grep -v '^$' | sort -u || true
}

# wait <pr> [--timeout <s>]: block until no required check on the PR's
# current head is pending. Exit 0 when all green, 1 on failing checks,
# 2 on usage, 3 on a merge conflict, 124 on timeout. The timeout counts
# seconds slept, not wall-clock time. A verdict is reported only for a
# head read both before and after its checks call. A conflict is reported
# only after the same head reads DIRTY for 30 s of 5 s polls (GitHub
# recomputes mergeability late after a push), or once the timeout budget
# is spent while DIRTY.
# On a draft PR (isDraft read once at the start), the base branch's
# required names are skipped and the checks call drops --required: the
# wait settles on the checks the head actually has, an empty list stays
# pending, and the pass line notes required checks run once ready.
# A required check on the head counts whenever it ran. A required name of
# the base branch with no check on the head counts as pending. When the
# required names were read and there are none, the verdict is pass without
# calling gh pr checks.
cmd_wait() {
  local pr="" timeout=1800 req="[]" empty_ok=false names
  while [ $# -gt 0 ]; do case "$1" in
    --timeout)
      [ $# -ge 2 ] || usage
      timeout="$2"; shift 2;;
    --*) usage;;
    *) [ -z "$pr" ] || usage; pr="$1"; shift;;
  esac; done
  [ -n "$pr" ] || usage
  case "$timeout" in ''|*[!0-9]*) usage;; esac
  local interval="${GH_CI_INTERVAL:-30}"
  local slept=0 head head2 state state2 checks_json padded verdict
  local dirty_head="" dirty_for=0 draft=false
  if [ "$(gh pr view "$pr" --repo "$REPO" --json isDraft --jq .isDraft 2>/dev/null)" = "true" ]; then
    draft=true
  fi
  if [ "$draft" = true ]; then
    :
  elif names=$(required_names "$pr" 2>/dev/null); then
    req=$(printf '%s' "$names" | jq -Rsc 'split("\n") | map(select(. != ""))')
    empty_ok=true
  else
    echo "gh-ci: cannot read required checks; absent ones are not detected" >&2
  fi
  while true; do
    read -r head state < <(head_state "$pr") || return 1
    if [ "$state" = "DIRTY" ]; then
      [ "$head" = "$dirty_head" ] || { dirty_head="$head"; dirty_for=0; }
      if [ "$dirty_for" -ge 30 ] || [ "$slept" -ge "$timeout" ]; then
        conflict_msg "$pr"
        return "$CONFLICT_RC"
      fi
      sleep 5
      slept=$((slept + 5))
      dirty_for=$((dirty_for + 5))
      continue
    fi
    dirty_head=""
    if [ "$draft" = true ]; then
      checks_json=$(gh pr checks "$pr" --repo "$REPO" --json name,bucket 2>&1 || true)
    elif [ "$empty_ok" = true ] && [ "$req" = "[]" ]; then
      checks_json='[]'
    else
      checks_json=$(gh pr checks "$pr" --repo "$REPO" --required --json name,bucket 2>&1 || true)
      padded=$(printf '%s' "$checks_json" | jq -c --argjson req "$req" '
        if type != "array" then . else
          . as $f | $f + [$req[] | select(. as $n | all($f[]; .name != $n)) | {name: ., bucket: "pending"}] end' 2>/dev/null) \
        && checks_json="$padded"
    fi
    verdict=$(printf '%s' "$checks_json" | jq -r --argjson empty_ok "$empty_ok" '
      if type == "array" and length == 0 and $empty_ok then "pass"
      elif type != "array" or length == 0 then "pending"
      elif any(.[]; .bucket != "pass" and .bucket != "skipping" and .bucket != "fail" and .bucket != "cancel") then "pending"
      elif any(.[]; .bucket == "fail" or .bucket == "cancel") then "fail"
      else "pass" end' 2>/dev/null) || verdict=pending
    case "$verdict" in pass|fail) ;; *) verdict="pending";; esac
    if [ "$verdict" = "pending" ]; then
      if [ "$slept" -ge "$timeout" ]; then
        echo "head: ${head:0:8} timeout after ${timeout}s"
        printf '%s' "$checks_json" | jq -r '.[] | select(.bucket != "pass" and .bucket != "skipping" and .bucket != "fail" and .bucket != "cancel") | "pending: \(.name)"' 2>/dev/null || true
        return 124
      fi
      sleep "$interval"
      slept=$((slept + interval))
      continue
    fi
    read -r head2 state2 < <(head_state "$pr") || return 1
    if [ "$head2" != "$head" ] || [ "$state2" = "DIRTY" ]; then
      continue
    fi
    if [ "$verdict" = "fail" ]; then
      echo "head: ${head:0:8} CI: fail"
      printf '%s' "$checks_json" | jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | "failing: \(.name)"' 2>/dev/null || true
      return 1
    fi
    if [ "$draft" = true ]; then
      echo "head: ${head:0:8} CI: pass (draft: required checks run once ready)"
    else
      echo "head: ${head:0:8} CI: pass"
    fi
    return 0
  done
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in snapshot|failures|watch-verified|resample|wait) ;; *) usage ;; esac
REPO="${GH_CI_REPO:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}"
case "$cmd" in
  snapshot) cmd_snapshot "$@" ;;
  failures) cmd_failures "$@" ;;
  watch-verified) cmd_watch_verified "$@" ;;
  resample) cmd_resample "$@" ;;
  wait) cmd_wait "$@" ;;
  *) usage ;;
esac
